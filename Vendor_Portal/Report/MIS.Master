<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>

<!DOCTYPE html>

<html>
<head runat="server">
   <title>Infinity IPS - AP Billing</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.8/css/line.css">
    <!-- Font Awesome Icons -->
    <script src="../plugins/jquery/jquery.min.js"></script>
    <link rel="stylesheet" href="../plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="../plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="../plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="../plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="../dist/css/adminlte.min.css">
    <link rel="stylesheet" href="../dist/css/ap-billing-theme.css">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <script>
    $(document).ready(function () {
        var currentUserId = parseInt($('#hdfCurrentUserId').val()) || 0;
        if (currentUserId === 235 || currentUserId === 5 || currentUserId === 6959 || currentUserId === 12) {
            loadPendingNotifications();
            $(document).on('click', 'a[href*="Logout.aspx"]', function () {
                sessionStorage.removeItem('popupsShown');
            });
        } 
      
    });

    var pendingAgreementVendorIds = [];
    var pendingRateRevisionVendorIds = [];
    var pendingVendorIds = [];

    var isAutoPopupRunning = false;

    function loadPendingNotifications() {
        var totalCount = 0;
        var sidebarHtml = '';

        $.ajax({
            type: "POST",
            url: "../Vendor/Dashboard.aspx/GetVendorInfoForPopUp",
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var result = response.d;
                var data = typeof result === 'string' ? JSON.parse(result) : result;

                if (data && data.length > 0 && data[0].VendorsName) {
                    var vendorsString = data[0].VendorsName;
                    var vendorsArray = vendorsString.split(',');
                    var listHtml = '';
                    vendorsArray.forEach(function (name) {
                        listHtml += `<li>${name.trim()}</li>`;
                    });
                    if (data[0].VendorIds) {
                        var idsArray = data[0].VendorIds.split(',');
                        idsArray.forEach(function (id) {
                            if (id.trim() !== '') {
                                pendingAgreementVendorIds.push(parseInt(id.trim()));
                            }
                        });
                    }
                    $('#vendorList').html(listHtml);
                    totalCount += 1;
                    sidebarHtml += `<div class="mb-3 p-3 bg-secondary rounded shadow-sm" style="cursor:pointer;" onclick="openManualModal('#successModal');"><i class="fas fa-file-contract text-warning"></i> <strong>Agreement Renewal Notice</strong><br/><small class="text-light">Expired agreements require attention.</small></div>`;
                }
                checkRateRevisionNotification(totalCount, sidebarHtml);
            },
            error: function (error) {
                console.log("Error: " + error.responseText);
                checkRateRevisionNotification(totalCount, sidebarHtml);
            }
        });
    }

    function checkRateRevisionNotification(totalCount, sidebarHtml) {
        $.ajax({
            type: "POST",
            url: "../Vendor/Dashboard.aspx/GetVendorRateRevisionDateInfoForPopup",
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var result = response.d;
                var data = typeof result === 'string' ? JSON.parse(result) : result;

                if (data && data.length > 0 && data[0].VendorsRateRevisionDateName) {
                    var vendorsString = data[0].VendorsRateRevisionDateName;
                    var vendorsArray = vendorsString.split(',');
                    var listHtml = '';
                    vendorsArray.forEach(function (name) {
                        listHtml += `<li>${name.trim()}</li>`;
                    });

                    if (data[0].VendorIds) {
                        var idsArray = data[0].VendorIds.split(',');
                        idsArray.forEach(function (id) {
                            if (id.trim() !== '') {
                                pendingRateRevisionVendorIds.push(parseInt(id.trim()));
                            }
                        });
                    }

                    $('#RateRevisionDateList').html(listHtml);
                    totalCount += 1;
                    sidebarHtml += `<div class="mb-3 p-3 bg-secondary rounded shadow-sm" style="cursor:pointer;" onclick="openManualModal('#RateRevisionDateModal');"><i class="fas fa-calendar-alt text-info"></i> <strong>Rate Revision Date Notice</strong><br/><small class="text-light">Rate revision dates have expired.</small></div>`;
                }
                checkRateStatusNotification(totalCount, sidebarHtml);
            },
            error: function (error) {
                console.log("Error: " + error.responseText);
                checkRateStatusNotification(totalCount, sidebarHtml);
            }
        });
    }

    function checkRateStatusNotification(totalCount, sidebarHtml) {
        pendingVendorIds = [];
        $.ajax({
            type: "POST",
            url: "../Vendor/Dashboard.aspx/GetVendorRateStatusInfoForPopUp",
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var result = response.d;
                var data = typeof result === 'string' ? JSON.parse(result) : result;

                if (data && data.length > 0) {
                    var listHtml = '';
                    data.forEach(function (row) {
                        var vendorName = row.VendorName;
                        var status = row.IsApprovedStatus;
                        var vendorId = row.VendorId;
                        if (vendorName) {
                            listHtml += `<li><strong>${vendorName.trim()}</strong> - <span style="color: red;">Rate Approval Status: ${status}</span></li>`;
                            pendingVendorIds.push(parseInt(vendorId));
                        }
                    });

                    if (listHtml !== '') {
                        $('#RateStatusList').html(listHtml);
                        totalCount += 1;
                        sidebarHtml += `<div class="mb-3 p-3 bg-secondary rounded shadow-sm" style="cursor:pointer;" onclick="openManualModal('#RateStatusModal');"><i class="fas fa-check-circle text-success"></i> <strong>Rate Approved Status Notice</strong><br/><small class="text-light">Rate approval pending.</small></div>`;
                    }
                }
                finalizeNotifications(totalCount, sidebarHtml);
            },
            error: function (error) {
                console.log("Error: " + error.responseText);
                finalizeNotifications(totalCount, sidebarHtml);
            }
        });
    }

    function finalizeNotifications(totalCount, sidebarHtml) {
        if (totalCount > 0) {
            $('#admin_pendingtask').text(totalCount).show();
            $('#dvsidebar').html(sidebarHtml);

            if (!sessionStorage.getItem('popupsShown')) {
                isAutoPopupRunning = true; 
                showNextPendingModal();
                sessionStorage.setItem('popupsShown', 'true');
            }

        } else {
            $('#admin_pendingtask').hide();
            $('#dvsidebar').html('<p class="text-muted" style="padding: 10px;">No pending tasks.</p>');
        }
    }

    function openManualModal(modalId) {
        isAutoPopupRunning = false;
        $(modalId).modal('show');
    }

    function showNextPendingModal() {
        if (pendingAgreementVendorIds.length > 0) {
            $('#successModal').modal('show');
        }
        else if (pendingRateRevisionVendorIds.length > 0) {
            $('#RateRevisionDateModal').modal('show');
        }
        else if (pendingVendorIds.length > 0) {
            $('#RateStatusModal').modal('show');
        }
    }

    $(document).on('click', '#successModal [data-dismiss="modal"], #successModal .close', function () {
        if (pendingAgreementVendorIds.length > 0) {
            $.ajax({
                type: "POST",
                url: "../Vendor/Dashboard.aspx/MarkNotificationAsRead",
                data: JSON.stringify({ VendorId: pendingAgreementVendorIds, notificationType: "AgreementDate" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) { }
            });
        }
        $('#successModal').modal('hide');
        pendingAgreementVendorIds = [];

        setTimeout(function () {
            if (isAutoPopupRunning) {
                showNextPendingModal();
            }
        }, 300);
    });

    $(document).on('click', '#RateRevisionDateModal [data-dismiss="modal"], #RateRevisionDateModal .close', function () {
        if (pendingRateRevisionVendorIds.length > 0) {
            $.ajax({
                type: "POST",
                url: "../Vendor/Dashboard.aspx/MarkNotificationAsRead",
                data: JSON.stringify({ VendorId: pendingRateRevisionVendorIds, notificationType: "RateRevisionDate" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) { }
            });
        }
        $('#RateRevisionDateModal').modal('hide');
        pendingRateRevisionVendorIds = [];

        setTimeout(function () {
            if (isAutoPopupRunning) {
                showNextPendingModal();
            }
        }, 300);
    });

    $(document).on('click', '#RateStatusModal [data-dismiss="modal"], #RateStatusModal .close, #RateStatusModal .btn-primary', function () {
        if (pendingVendorIds.length > 0) {
            $.ajax({
                type: "POST",
                url: "../Vendor/Dashboard.aspx/MarkNotificationAsRead",
                data: JSON.stringify({ VendorId: pendingVendorIds, notificationType: "RateStatus" }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) { }
            });
        }
        $('#RateStatusModal').modal('hide');
        pendingVendorIds = [];
    });
    </script>
</head>
