<div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="agreementModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0" style="border-radius: 6px;">
            <!-- Modal Header -->
            <div class="modal-header bg-white px-4 py-3 align-items-center" style="border-bottom: 1px solid #f1f3f5;">
                <div class="d-flex align-items-center">
                    <div class="bg-light-primary text-primary rounded-circle d-flex align-items-center justify-content-center mr-3" style="width: 40px; height: 40px; background-color: rgba(0, 123, 255, 0.1);">
                        <i class="fas fa-bell" style="font-size: 1.1rem;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title font-weight-bold text-dark mb-0" id="agreementModalLabel" style="font-size: 1.15rem; letter-spacing: -0.2px;">Important Notification
                        </h5>
                        <small class="text-muted">Agreement Renewal Notice – Action Required</small>
                    </div>
                </div>
                <button type="button" class="close text-secondary" data-dismiss="modal" aria-label="Close" style="font-size: 1.25rem; outline: none; opacity: 0.7;">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <!-- Modal Body -->
            <div class="modal-body p-4" style="font-size: 0.95rem; color: #333; line-height: 1.6;">
                <!-- Message Row -->
                <div class="row">
                    <div class="col-sm-12">
                        <ul class="list-unstyled pl-0 mb-0">
                            <li class="mb-2">
                                <span class="font-weight-bold">Attention!</span> This is to notify you that the following vendor's  Agreement has expired and requires your attention.
                                                     
                            </li>
                            <li class="mb-3 p-2 bg-light border rounded" style="font-size: 0.9rem;">
                                <span class="font-weight-bold">Vendor Name:</span>
                                <ul id="vendorList" style="list-style-type: disc !important; padding-left: 20px;" class="mt-1 mb-0"></ul>
                            </li>

                            <li class="mb-0 text-danger mt-3 p-2 rounded d-flex align-items-center" style="font-weight: 600; font-size: 0.88rem; background-color: rgba(220, 53, 69, 0.08);">
                                <i class="fas fa-exclamation-circle mr-2" style="font-size: 1rem;"></i>
                                <span>Important Message:  Agreement has expired. Please renew agreement as soon as possible!</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-light justify-content-end py-3 px-4" style="border-top: 1px solid #e9ecef;">
                <button type="button" class="btn btn-primary px-4 py-2" data-dismiss="modal" style="background-color: #007bff; border-color: #007bff; border-radius: 4px; font-weight: 500;">
                    Mark as read        
                </button>
            </div>
        </div>
    </div>
</div>

